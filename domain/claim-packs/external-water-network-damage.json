  "sourceRequirementRef": "source.requirements.special-fire-coverage-engine",
  "conditionDocumentRequirement": {"required": true, "resolution": "runtime-by-policy-and-loss-date", "unknownValidityLabelFa": "نیازمند تطبیق با آخرین شرایط و بخشنامه‌های شرکت"},
  "decisionPolicy": {"automatedFinalDecision": false, "authorizedHumanDecisionRequired": true, "missingEvidenceEffect": "additional-evidence-required", "potentialExclusionEffect": "potential-exclusion", "allowedMachineStatuses": ["potentially-applicable", "not-yet-established", "additional-evidence-required", "potential-exclusion", "outside-selected-coverage", "requires-senior-review"], "humanOnlyStatuses": ["approved-by-authorized-user", "rejected-by-authorized-user"]},
  "trigger": {"all": [{"fact": "claim.selectedCoverageIds", "operator": "contains", "value": "coverage.fire.special.water.external-network-damage"}, {"fact": "claim.lossReported", "operator": "truthy"}]},
  "sections": [{"id": "network-source", "titleFa": "شبکه، مالکیت و منشأ", "questionIds": ["sourceExact", "failedComponent", "locationBoundary", "networkOwnership", "utilityNotification", "cause", "onset"]}, {"id": "history-damage", "titleFa": "سابقه و خسارت", "questionIds": ["previousFailure", "maintenanceHistory", "waterEntryRoute", "damageDescription"]}, {"id": "costs", "titleFa": "تفکیک هزینه", "questionIds": ["networkRepairCost", "excavationRestorationCost", "consequentialDamageCost", "cleanupDryingCost"]}],
  "questions": [
    {"id": "sourceExact", "fact": "externalWater.sourceExact", "type": "textarea", "labelFa": "منشأ دقیق خروج آب", "required": true},
    {"id": "failedComponent", "fact": "externalWater.failedComponent", "type": "textarea", "labelFa": "لوله، اتصال، شیر یا جزء معیوب", "required": true},
    {"id": "locationBoundary", "fact": "externalWater.locationBoundary", "type": "singleChoice", "labelFa": "محل جزء معیوب نسبت به مرز محل خطر", "required": true, "options": [{"value": "insideInsuredPremises", "labelFa": "داخل محوطه محل خطر"}, {"value": "outsideInsuredPremises", "labelFa": "خارج از محوطه محل خطر"}, {"value": "publicRightOfWay", "labelFa": "معبر عمومی"}, {"value": "undetermined", "labelFa": "نیازمند بررسی"}]},
    {"id": "networkOwnership", "fact": "externalWater.networkOwnership", "type": "singleChoice", "labelFa": "مالک یا مسئول شبکه", "required": true, "options": [{"value": "insured", "labelFa": "بیمه‌گذار یا بیمه‌شده"}, {"value": "utility", "labelFa": "شرکت آب یا بهره‌بردار"}, {"value": "landlord", "labelFa": "مالک ملک"}, {"value": "thirdParty", "labelFa": "شخص ثالث"}, {"value": "undetermined", "labelFa": "نیازمند بررسی"}]},
    {"id": "utilityNotification", "fact": "externalWater.utilityNotification", "type": "textarea", "labelFa": "وضعیت اعلام و پاسخ شرکت آب یا بهره‌بردار", "required": true},
    {"id": "cause", "fact": "externalWater.cause", "type": "textarea", "labelFa": "علت مشاهده‌شده یا اعلامی خرابی", "required": true},
    {"id": "onset", "fact": "externalWater.onset", "type": "singleChoice", "labelFa": "وقوع ناگهانی بوده یا تدریجی؟", "required": true, "options": [{"value": "sudden", "labelFa": "ناگهانی"}, {"value": "gradual", "labelFa": "تدریجی"}, {"value": "undetermined", "labelFa": "نیازمند بررسی"}]},
    {"id": "previousFailure", "fact": "history.previousExternalWaterFailure", "type": "textarea", "labelFa": "سابقه نشت یا خرابی قبلی", "required": true},
    {"id": "maintenanceHistory", "fact": "history.externalNetworkMaintenance", "type": "textarea", "labelFa": "سوابق نگهداری و تعمیر شبکه", "required": true},
    {"id": "waterEntryRoute", "fact": "externalWater.entryRoute", "type": "textarea", "labelFa": "مسیر ورود آب از شبکه خارجی به محل خسارت", "required": true},
    {"id": "damageDescription", "fact": "damage.description", "type": "textarea", "labelFa": "شرح خسارت ساختمان، محوطه و اموال", "required": true},
    {"id": "networkRepairCost", "fact": "cost.networkRepair", "type": "currency", "labelFa": "تعمیر خود شبکه یا جزء معیوب", "required": true, "currency": "IRR"},
    {"id": "excavationRestorationCost", "fact": "cost.excavationRestoration", "type": "currency", "labelFa": "حفاری و بازسازی سطح", "required": true, "currency": "IRR"},
    {"id": "consequentialDamageCost", "fact": "cost.consequentialDamage", "type": "currency", "labelFa": "خسارت تبعی اموال", "required": true, "currency": "IRR"},
    {"id": "cleanupDryingCost", "fact": "cost.cleanupDrying", "type": "currency", "labelFa": "پاک‌سازی و خشک‌سازی", "required": true, "currency": "IRR"}
  ],
  "requiredEvidence": [{"id": "ev.external-network-photos", "titleFa": "عکس محل شبکه، جزء معیوب، مسیر آب و خسارت", "type": "photoSet", "requiredMode": "always", "photoRequirementPackId": "photo.fire.special.water.external-network-damage", "absenceEffect": "additional-evidence-required"}, {"id": "ev.utility-report", "titleFa": "گزارش شرکت آب یا بهره‌بردار، در صورت ارتباط", "type": "externalRecord", "requiredMode": "required_or_unavailability_reason", "absenceEffect": "additional-evidence-required"}, {"id": "ev.technical-report", "titleFa": "گزارش فنی محل و علت خرابی", "type": "expertDocument", "requiredMode": "required_or_unavailability_reason", "absenceEffect": "additional-evidence-required"}, {"id": "ev.ownership-boundary", "titleFa": "مدرک یا نقشه مالکیت و مرز مسئولیت شبکه", "type": "documentOrStatement", "requiredMode": "required_or_unavailability_reason", "absenceEffect": "additional-evidence-required"}, {"id": "ev.itemized-invoices", "titleFa": "فاکتور تفکیکی تعمیر شبکه، حفاری و خسارت تبعی", "type": "document", "requiredMode": "always", "absenceEffect": "additional-evidence-required"}],
  "photos": [{"requirementPackRef": "photo.fire.special.water.external-network-damage", "required": true}],
  "calculationComponents": [{"id": "calc.network-repair", "titleFa": "تعمیر شبکه یا جزء معیوب", "sourceFact": "cost.networkRepair", "coverageTreatment": "separate_expert_determination"}, {"id": "calc.excavation-restoration", "titleFa": "حفاری و بازسازی سطح", "sourceFact": "cost.excavationRestoration", "coverageTreatment": "separate_expert_determination"}, {"id": "calc.consequential-damage", "titleFa": "خسارت تبعی اموال", "sourceFact": "cost.consequentialDamage", "coverageTreatment": "candidate_recoverable_item"}, {"id": "calc.cleanup-drying", "titleFa": "پاک‌سازی و خشک‌سازی", "sourceFact": "cost.cleanupDrying", "coverageTreatment": "separate_expert_determination"}, {"id": "calc.deductible", "titleFa": "فرانشیز", "inputMode": "resolved_rule", "deductibleRuleRef": "condition-document-current-version", "hardcodedAmountAllowed": false}],
  "deductibleRule": {"source": "verified-condition-document", "required": true, "hardcodedAmountAllowed": false, "unresolvedEffect": "requires-senior-review"},
  "potentialExclusions": [{"id": "exclusion.unverified-condition", "titleFa": "شرایط و استثنائات این پوشش هنوز با سند معتبر پرونده تطبیق نشده است", "when": {"fact": "coverage.verificationStatus", "operator": "neq", "value": "verified"}, "effect": "flag_for_expert_review"}, {"id": "exclusion.outside-boundary-ownership", "titleFa": "شبکه خارج از مرز محل خطر یا متعلق به دیگری", "when": {"any": [{"fact": "externalWater.locationBoundary", "operator": "in", "value": ["outsideInsuredPremises", "publicRightOfWay"]}, {"fact": "externalWater.networkOwnership", "operator": "in", "value": ["utility", "thirdParty"]}]}, "effect": "flag_for_expert_review"}, {"id": "exclusion.gradual-event", "titleFa": "وقوع تدریجی", "when": {"fact": "externalWater.onset", "operator": "eq", "value": "gradual"}, "effect": "flag_for_expert_review"}, {"id": "exclusion.network-repair", "titleFa": "تعمیر خود شبکه و حفاری", "when": {"any": [{"fact": "cost.networkRepair", "operator": "gt", "value": 0}, {"fact": "cost.excavationRestoration", "operator": "gt", "value": 0}]}, "effect": "separate_and_flag_for_expert_review"}],
  "duties": [{"id": "duty.notify-operator", "titleFa": "اعلام به بهره‌بردار مسئول، در صورت ارتباط", "failureEffect": "record_warning_and_refer_to_expert"}, {"id": "duty.limit-flow", "titleFa": "مهار معقول جریان و توسعه خسارت", "failureEffect": "record_warning_and_refer_to_expert"}, {"id": "duty.preserve-before-repair", "titleFa": "عکاسی و حفظ شواهد پیش از تعمیر", "failureEffect": "record_warning_and_refer_to_expert"}],
  "reportBindings": [{"sectionId": "report.network-source", "titleFa": "شبکه، مالکیت و منشأ", "facts": ["externalWater.sourceExact", "externalWater.failedComponent", "externalWater.locationBoundary", "externalWater.networkOwnership", "externalWater.utilityNotification", "externalWater.cause", "externalWater.onset"]}, {"sectionId": "report.entry-damage", "titleFa": "مسیر آب و خسارت", "facts": ["externalWater.entryRoute", "damage.description"]}, {"sectionId": "report.evidence", "titleFa": "شواهد و کسری مدارک", "bind": "evidenceAssessment"}, {"sectionId": "report.exclusions", "titleFa": "موارد نیازمند بررسی", "bind": "potentialExclusionFlags"}, {"sectionId": "report.calculation", "titleFa": "تفکیک محاسبه", "bind": "calculationComponents"}, {"sectionId": "report.decision", "titleFa": "وضعیت تصمیم کارشناس", "bind": "expertDecisionStatus", "humanApprovalRequired": true}],
  "reportWording": {"sourceCautionFa": "شبکه خارجی آب بر پایه محل خرابی، مالکیت، مرز مسئولیت و مسیر ورود آب مستقل از شبکه داخلی بررسی می‌شود.", "decisionDisclaimerFa": "این گزارش تصمیم نهایی پوشش یا پرداخت نیست و تأیید یا رد فقط توسط کاربر مجاز و پس از تطبیق شرایط معتبر انجام می‌شود."}
}
