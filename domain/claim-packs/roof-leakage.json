  "decisionPolicy": {"automatedFinalDecision": false, "authorizedHumanDecisionRequired": true, "missingEvidenceEffect": "additional-evidence-required", "potentialExclusionEffect": "potential-exclusion", "allowedMachineStatuses": ["potentially-applicable", "not-yet-established", "additional-evidence-required", "potential-exclusion", "outside-selected-coverage", "requires-senior-review"], "humanOnlyStatuses": ["approved-by-authorized-user", "rejected-by-authorized-user"]},
  "trigger": {"all": [{"fact": "claim.selectedCoverageIds", "operator": "contains", "value": "coverage.fire.special.water.roof-leakage"}, {"fact": "claim.lossReported", "operator": "truthy"}]},
  "sections": [{"id": "weather-roof", "titleFa": "رویداد و بام", "questionIds": ["weatherContext", "roofType", "entryRoute", "observedDefect", "onset", "alternativeSources"]}, {"id": "history-damage", "titleFa": "سابقه و خسارت", "questionIds": ["roofAge", "maintenanceHistory", "previousLeakage", "damageDescription", "openAirProperty"]}, {"id": "costs", "titleFa": "تفکیک هزینه", "questionIds": ["roofRepairCost", "waterproofingCost", "consequentialDamageCost", "dryingCost"]}],
  "questions": [
    {"id": "weatherContext", "fact": "roof.weatherContext", "type": "textarea", "labelFa": "وضعیت جوی پیش و هنگام مشاهده نشت", "required": true},
    {"id": "roofType", "fact": "roof.type", "type": "text", "labelFa": "نوع بام، پوشش و عایق", "required": true},
    {"id": "entryRoute", "fact": "roof.entryRoute", "type": "textarea", "labelFa": "مسیر احتمالی ورود آب از بام", "required": true},
    {"id": "observedDefect", "fact": "roof.observedDefect", "type": "textarea", "labelFa": "نقص، شکستگی، درز یا گرفتگی مشاهده‌شده", "required": true},
    {"id": "onset", "fact": "roof.onset", "type": "singleChoice", "labelFa": "نشت ناگهانی بوده یا تدریجی؟", "required": true, "options": [{"value": "sudden", "labelFa": "ناگهانی"}, {"value": "gradual", "labelFa": "تدریجی"}, {"value": "undetermined", "labelFa": "نیازمند بررسی"}]},
    {"id": "alternativeSources", "fact": "roof.alternativeSources", "type": "multiChoice", "labelFa": "منشأهای جایگزین بررسی‌شده", "required": true, "options": [{"value": "pipe", "labelFa": "لوله"}, {"value": "tank", "labelFa": "مخزن"}, {"value": "wallOpening", "labelFa": "درز یا بازشوی دیوار"}, {"value": "flood", "labelFa": "سیل"}, {"value": "noneObserved", "labelFa": "مشاهده نشد"}, {"value": "undetermined", "labelFa": "نیازمند بررسی"}]},
    {"id": "roofAge", "fact": "roof.ageYears", "type": "number", "labelFa": "سن تقریبی بام یا آخرین عایق‌کاری", "required": true, "minimum": 0},
    {"id": "maintenanceHistory", "fact": "history.roofMaintenance", "type": "textarea", "labelFa": "سوابق نگهداری و تعمیر بام و آبرو", "required": true},
    {"id": "previousLeakage", "fact": "history.previousRoofLeakage", "type": "textarea", "labelFa": "سابقه نشت یا لکه قبلی", "required": true},
    {"id": "damageDescription", "fact": "damage.description", "type": "textarea", "labelFa": "شرح خسارت تبعی", "required": true},
    {"id": "openAirProperty", "fact": "damage.openAirProperty", "type": "boolean", "labelFa": "آیا بخشی از اموال آسیب‌دیده در فضای باز بوده است؟", "required": true},
    {"id": "roofRepairCost", "fact": "cost.roofRepair", "type": "currency", "labelFa": "تعمیر جزء معیوب بام", "required": true, "currency": "IRR"},
    {"id": "waterproofingCost", "fact": "cost.waterproofing", "type": "currency", "labelFa": "عایق‌کاری", "required": true, "currency": "IRR"},
    {"id": "consequentialDamageCost", "fact": "cost.consequentialDamage", "type": "currency", "labelFa": "خسارت تبعی اموال", "required": true, "currency": "IRR"},
    {"id": "dryingCost", "fact": "cost.drying", "type": "currency", "labelFa": "خشک‌سازی", "required": true, "currency": "IRR"}
  ],
  "requiredEvidence": [{"id": "ev.roof-photos", "titleFa": "عکس بام، نقص، مسیر نشت و خسارت داخلی", "type": "photoSet", "requiredMode": "always", "photoRequirementPackId": "photo.fire.special.water.roof-leakage", "absenceEffect": "additional-evidence-required"}, {"id": "ev.weather-record", "titleFa": "سابقه وضعیت جوی محل و زمان", "type": "externalRecord", "requiredMode": "required_or_unavailability_reason", "absenceEffect": "additional-evidence-required"}, {"id": "ev.roof-inspection", "titleFa": "گزارش فنی بام، عایق و مسیر نشت", "type": "expertDocument", "requiredMode": "required_or_unavailability_reason", "absenceEffect": "additional-evidence-required"}, {"id": "ev.maintenance", "titleFa": "سوابق نگهداری و عایق‌کاری", "type": "documentOrStatement", "requiredMode": "required_or_unavailability_reason", "absenceEffect": "additional-evidence-required"}, {"id": "ev.itemized-estimate", "titleFa": "برآورد تفکیکی تعمیر بام و خسارت تبعی", "type": "document", "requiredMode": "always", "absenceEffect": "additional-evidence-required"}],
  "photos": [{"requirementPackRef": "photo.fire.special.water.roof-leakage", "required": true}],
  "calculationComponents": [{"id": "calc.roof-repair", "titleFa": "تعمیر جزء معیوب بام", "sourceFact": "cost.roofRepair", "coverageTreatment": "separate_expert_determination"}, {"id": "calc.waterproofing", "titleFa": "عایق‌کاری", "sourceFact": "cost.waterproofing", "coverageTreatment": "separate_expert_determination"}, {"id": "calc.consequential-damage", "titleFa": "خسارت تبعی اموال", "sourceFact": "cost.consequentialDamage", "coverageTreatment": "candidate_recoverable_item"}, {"id": "calc.drying", "titleFa": "خشک‌سازی", "sourceFact": "cost.drying", "coverageTreatment": "separate_expert_determination"}, {"id": "calc.deductible", "titleFa": "فرانشیز", "inputMode": "resolved_rule", "deductibleRuleRef": "condition-document-current-version", "hardcodedAmountAllowed": false}],
  "deductibleRule": {"source": "verified-condition-document", "required": true, "hardcodedAmountAllowed": false, "unresolvedEffect": "requires-senior-review"},
  "potentialExclusions": [{"id": "exclusion.unverified-condition", "titleFa": "شرایط و استثنائات این پوشش هنوز با سند معتبر پرونده تطبیق نشده است", "when": {"fact": "coverage.verificationStatus", "operator": "neq", "value": "verified"}, "effect": "flag_for_expert_review"}, {"id": "exclusion.gradual-leakage", "titleFa": "نشت تدریجی", "when": {"fact": "roof.onset", "operator": "eq", "value": "gradual"}, "effect": "flag_for_expert_review"}, {"id": "exclusion.roof-waterproofing", "titleFa": "تعمیر بام یا عایق‌کاری", "when": {"any": [{"fact": "cost.roofRepair", "operator": "gt", "value": 0}, {"fact": "cost.waterproofing", "operator": "gt", "value": 0}]}, "effect": "separate_and_flag_for_expert_review"}, {"id": "exclusion.alternative-source", "titleFa": "احتمال منشأ دیگر آب", "when": {"not": {"fact": "roof.alternativeSources", "operator": "contains", "value": "noneObserved"}}, "effect": "flag_and_route_to_related_peril_review"}],
  "duties": [{"id": "duty.limit-ingress", "titleFa": "کاهش معقول ورود آب بدون ازبین‌بردن شواهد", "failureEffect": "record_warning_and_refer_to_expert"}, {"id": "duty.photograph-before-repair", "titleFa": "عکاسی پیش از تعمیر", "failureEffect": "record_warning_and_refer_to_expert"}],
  "reportBindings": [{"sectionId": "report.roof-source", "titleFa": "بام، نقص و مسیر نشت", "facts": ["roof.weatherContext", "roof.type", "roof.entryRoute", "roof.observedDefect", "roof.onset", "roof.alternativeSources"]}, {"sectionId": "report.damage", "titleFa": "خسارت و تفکیک هزینه", "facts": ["damage.description", "damage.openAirProperty"], "bind": "calculationComponents"}, {"sectionId": "report.evidence", "titleFa": "شواهد و کسری مدارک", "bind": "evidenceAssessment"}, {"sectionId": "report.exclusions", "titleFa": "موارد نیازمند بررسی", "bind": "potentialExclusionFlags"}, {"sectionId": "report.decision", "titleFa": "وضعیت تصمیم کارشناس", "bind": "expertDecisionStatus", "humanApprovalRequired": true}],
  "reportWording": {"sourceCautionFa": "نشت بام مستقل از سیل، نفوذ آب از بازشوها و خرابی لوله یا مخزن بررسی می‌شود.", "decisionDisclaimerFa": "این گزارش تصمیم نهایی پوشش یا پرداخت نیست و تأیید یا رد فقط توسط کاربر مجاز و پس از تطبیق شرایط معتبر انجام می‌شود."}
}
