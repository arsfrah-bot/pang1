{
  "schemaVersion": "1.0.0",
  "id": "claim.fire.special.water.sewer-overflow",
  "version": "1.0.0",
  "status": "draft_requires_source_verification",
  "titleFa": "پس‌زدگی و سرریز شبکه فاضلاب",
  "lineId": "insurance.fire-property",
  "coverageRef": "coverage.fire.special.water.sewer-overflow",
  "sourceRequirementRef": "source.requirements.special-fire-coverage-engine",
  "conditionDocumentRequirement": {"required": true, "resolution": "runtime-by-policy-and-loss-date", "unknownValidityLabelFa": "نیازمند تطبیق با آخرین شرایط و بخشنامه‌های شرکت"},
  "decisionPolicy": {"automatedFinalDecision": false, "authorizedHumanDecisionRequired": true, "missingEvidenceEffect": "additional-evidence-required", "potentialExclusionEffect": "potential-exclusion", "allowedMachineStatuses": ["potentially-applicable", "not-yet-established", "additional-evidence-required", "potential-exclusion", "outside-selected-coverage", "requires-senior-review"], "humanOnlyStatuses": ["approved-by-authorized-user", "rejected-by-authorized-user"]},
  "trigger": {"all": [{"fact": "claim.selectedCoverageIds", "operator": "contains", "value": "coverage.fire.special.water.sewer-overflow"}, {"fact": "claim.lossReported", "operator": "truthy"}]},
  "sections": [
    {"id": "source-event", "titleFa": "منشأ و وقوع", "questionIds": ["sourceExact", "networkPosition", "networkOwnership", "entryPoint", "cause", "suddenOrGradual", "contamination"]},
    {"id": "history-damage", "titleFa": "سابقه و خسارت", "questionIds": ["previousEvent", "maintenanceHistory", "damageDescription", "affectedArea"]},
    {"id": "costs", "titleFa": "تفکیک هزینه", "questionIds": ["networkRepairCost", "consequentialDamageCost", "cleanupDecontaminationCost"]}
  ],
  "questions": [
    {"id": "sourceExact", "fact": "sewer.sourceExact", "type": "textarea", "labelFa": "منشأ دقیق فاضلاب یا آب آلوده", "required": true},
    {"id": "networkPosition", "fact": "sewer.networkPosition", "type": "singleChoice", "labelFa": "شبکه داخلی است یا عمومی/خارجی؟", "required": true, "options": [{"value": "internal", "labelFa": "داخلی"}, {"value": "publicExternal", "labelFa": "عمومی یا خارجی"}, {"value": "undetermined", "labelFa": "هنوز مشخص نشده"}]},
    {"id": "networkOwnership", "fact": "sewer.networkOwnership", "type": "text", "labelFa": "مالک یا مسئول شبکه", "required": true},
    {"id": "entryPoint", "fact": "sewer.entryPoint", "type": "textarea", "labelFa": "نقطه ورود یا پس‌زدگی", "required": true},
    {"id": "cause", "fact": "sewer.cause", "type": "multiChoice", "labelFa": "علت مشاهده‌شده یا اعلامی", "required": true, "options": [{"value": "blockage", "labelFa": "گرفتگی"}, {"value": "overflow", "labelFa": "سرریز"}, {"value": "networkFailure", "labelFa": "خرابی شبکه"}, {"value": "heavyRain", "labelFa": "بارندگی شدید"}, {"value": "unknown", "labelFa": "نامشخص"}, {"value": "other", "labelFa": "سایر"}]},
    {"id": "suddenOrGradual", "fact": "sewer.onset", "type": "singleChoice", "labelFa": "وقوع ناگهانی بوده یا تدریجی؟", "required": true, "options": [{"value": "sudden", "labelFa": "ناگهانی"}, {"value": "gradual", "labelFa": "تدریجی"}, {"value": "undetermined", "labelFa": "نیازمند بررسی"}]},
    {"id": "contamination", "fact": "sewer.contaminationDescription", "type": "textarea", "labelFa": "نوع و گستره آلودگی", "required": true},
    {"id": "previousEvent", "fact": "history.previousSewerOverflow", "type": "textarea", "labelFa": "سابقه پس‌زدگی یا سرریز قبلی", "required": true},
    {"id": "maintenanceHistory", "fact": "history.sewerMaintenance", "type": "textarea", "labelFa": "سابقه پاک‌سازی و نگهداری شبکه", "required": true},
    {"id": "damageDescription", "fact": "damage.description", "type": "textarea", "labelFa": "شرح خسارت اموال و ساختمان", "required": true},
    {"id": "affectedArea", "fact": "damage.affectedAreaSqm", "type": "number", "labelFa": "مساحت تقریبی درگیر بر حسب مترمربع", "required": true, "minimum": 0},
    {"id": "networkRepairCost", "fact": "cost.networkRepair", "type": "currency", "labelFa": "هزینه رفع عیب یا تعمیر شبکه", "required": true, "currency": "IRR"},
    {"id": "consequentialDamageCost", "fact": "cost.consequentialDamage", "type": "currency", "labelFa": "خسارت تبعی اموال بیمه‌شده", "required": true, "currency": "IRR"},
    {"id": "cleanupDecontaminationCost", "fact": "cost.cleanupDecontamination", "type": "currency", "labelFa": "پاک‌سازی و رفع آلودگی", "required": true, "currency": "IRR"}
  ],
  "requiredEvidence": [
    {"id": "ev.sewer-photos", "titleFa": "عکس نقطه پس‌زدگی، آلودگی و خسارت", "type": "photoSet", "requiredMode": "always", "photoRequirementPackId": "photo.fire.special.water.sewer-overflow", "absenceEffect": "additional-evidence-required"},
    {"id": "ev.technical-report", "titleFa": "گزارش لوله‌کش یا کارشناس شبکه درباره منشأ و علت", "type": "document", "requiredMode": "required_or_unavailability_reason", "absenceEffect": "additional-evidence-required"},
    {"id": "ev.network-authority", "titleFa": "گزارش بهره‌بردار یا مرجع شبکه عمومی، در صورت ارتباط", "type": "externalRecord", "requiredMode": "required_or_not_applicable_reason", "absenceEffect": "additional-evidence-required"},
    {"id": "ev.cleanup-repair-invoices", "titleFa": "فاکتورهای تفکیکی تعمیر و رفع آلودگی", "type": "document", "requiredMode": "required_or_unavailability_reason", "absenceEffect": "additional-evidence-required"}
  ],
  "photos": [{"requirementPackRef": "photo.fire.special.water.sewer-overflow", "required": true}],
  "calculationComponents": [
    {"id": "calc.network-repair", "titleFa": "رفع عیب و تعمیر شبکه", "sourceFact": "cost.networkRepair", "coverageTreatment": "separate_expert_determination"},
    {"id": "calc.consequential-damage", "titleFa": "خسارت تبعی اموال بیمه‌شده", "sourceFact": "cost.consequentialDamage", "coverageTreatment": "candidate_recoverable_item"},
    {"id": "calc.cleanup-decontamination", "titleFa": "پاک‌سازی و رفع آلودگی", "sourceFact": "cost.cleanupDecontamination", "coverageTreatment": "separate_expert_determination"},
    {"id": "calc.salvage", "titleFa": "بازیافتی", "inputMode": "expert_itemization", "sign": "subtract_after_authorization"},
    {"id": "calc.deductible", "titleFa": "فرانشیز", "inputMode": "resolved_rule", "deductibleRuleRef": "condition-document-current-version", "hardcodedAmountAllowed": false}
  ],
  "deductibleRule": {"source": "verified-condition-document", "required": true, "hardcodedAmountAllowed": false, "unresolvedEffect": "requires-senior-review"},
  "potentialExclusions": [
    {"id": "exclusion.unverified-condition", "titleFa": "شرایط و استثنائات این پوشش هنوز با سند معتبر پرونده تطبیق نشده است", "when": {"fact": "coverage.verificationStatus", "operator": "neq", "value": "verified"}, "effect": "flag_for_expert_review"},
    {"id": "exclusion.gradual-event", "titleFa": "وقوع تدریجی", "when": {"fact": "sewer.onset", "operator": "eq", "value": "gradual"}, "effect": "flag_for_expert_review"},
    {"id": "exclusion.network-repair", "titleFa": "هزینه رفع عیب خود شبکه", "when": {"fact": "cost.networkRepair", "operator": "gt", "value": 0}, "effect": "separate_and_flag_for_expert_review"}
  ],
  "duties": [{"id": "duty.stop-spread", "titleFa": "مهار معقول گسترش آلودگی", "failureEffect": "record_warning_and_refer_to_expert"}, {"id": "duty.preserve-evidence", "titleFa": "عکاسی و حفظ مدارک پیش از پاک‌سازی", "failureEffect": "record_warning_and_refer_to_expert"}],
  "reportBindings": [{"sectionId": "report.source", "titleFa": "منشأ، شبکه و مسیر ورود", "facts": ["sewer.sourceExact", "sewer.networkPosition", "sewer.networkOwnership", "sewer.entryPoint", "sewer.cause", "sewer.onset"]}, {"sectionId": "report.damage", "titleFa": "آلودگی و خسارت", "facts": ["sewer.contaminationDescription", "damage.description", "damage.affectedAreaSqm"]}, {"sectionId": "report.evidence", "titleFa": "شواهد موجود و کسری مدارک", "bind": "evidenceAssessment"}, {"sectionId": "report.exclusions", "titleFa": "موارد نیازمند بررسی", "bind": "potentialExclusionFlags"}, {"sectionId": "report.calculation", "titleFa": "تفکیک محاسبه", "bind": "calculationComponents"}, {"sectionId": "report.decision", "titleFa": "وضعیت تصمیم کارشناس", "bind": "expertDecisionStatus", "humanApprovalRequired": true}],
  "reportWording": {"sourceCautionFa": "پس‌زدگی فاضلاب مستقل از ترکیدگی لوله، سیل و نفوذ باران بررسی شده است.", "decisionDisclaimerFa": "این گزارش تصمیم نهایی پوشش یا پرداخت نیست و تأیید یا رد فقط توسط کاربر مجاز و پس از تطبیق شرایط معتبر انجام می‌شود."}
}
