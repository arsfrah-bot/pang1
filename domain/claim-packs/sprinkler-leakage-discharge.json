  "duties": [{"id": "duty.stop-discharge", "titleFa": "مهار ایمن تخلیه با رعایت الزامات سامانه", "failureEffect": "record_warning_and_refer_to_expert"}, {"id": "duty.preserve-logs", "titleFa": "حفظ گزارش‌ها و شواهد کنترل پنل", "failureEffect": "record_warning_and_refer_to_expert"}, {"id": "duty.prevent-development", "titleFa": "جلوگیری معقول از توسعه خسارت", "failureEffect": "record_warning_and_refer_to_expert"}],
  "reportBindings": [{"sectionId": "report.event-system", "titleFa": "رویداد و وضعیت سامانه", "facts": ["sprinkler.eventType", "sprinkler.triggerCause", "sprinkler.fireEventPresent", "sprinkler.systemOwnership", "sprinkler.failedComponentLocation", "sprinkler.onset"]}, {"sectionId": "report.damage", "titleFa": "خسارت و تفکیک هزینه", "facts": ["damage.description"], "bind": "calculationComponents"}, {"sectionId": "report.evidence", "titleFa": "شواهد موجود و کسری مدارک", "bind": "evidenceAssessment"}, {"sectionId": "report.exclusions", "titleFa": "موارد نیازمند بررسی", "bind": "potentialExclusionFlags"}, {"sectionId": "report.decision", "titleFa": "وضعیت تصمیم کارشناس", "bind": "expertDecisionStatus", "humanApprovalRequired": true}],
