  "reportBindings": [{"reportSectionId": "report.photos.network-source", "requirementIds": ["photo.external-network.location-boundary", "photo.external-network.failed-component", "photo.external-network.context-marker", "photo.external-network.excavation"]}, {"reportSectionId": "report.photos.damage", "requirementIds": ["photo.external-network.water-entry-route", "photo.external-network.damage", "photo.external-network.repair-restoration"]}]
