    {"id": "photo.external-network.context-marker", "titleFa": "نمای شبکه و شناسه بهره‌بردار", "requiredMode": "required_or_unavailability_reason", "minCount": 1, "maxCount": 6, "evidenceClassificationId": "photo-visible", "mustShowFa": ["کنتور، شیر، منهول یا نشانه مرتبط", "محیط اطراف"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.external-network.excavation", "titleFa": "حفاری و لایه‌های بازشده", "requiredMode": "required_or_not_applicable_reason", "minCount": 2, "maxCount": 10, "evidenceClassificationId": "photo-visible", "requiredWhen": {"fact": "repair.excavationPerformed", "operator": "truthy"}, "absenceEffect": "additional-evidence-required"},
    {"id": "photo.external-network.water-entry-route", "titleFa": "مسیر ورود آب به محل خسارت", "requiredMode": "always", "minCount": 2, "maxCount": 8, "evidenceClassificationId": "photo-visible", "absenceEffect": "additional-evidence-required"},
