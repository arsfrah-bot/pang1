    {"id": "photo.external-network.repair-restoration", "titleFa": "تعمیر شبکه و بازسازی سطح", "requiredMode": "required_or_unavailability_reason", "minCount": 1, "maxCount": 10, "evidenceClassificationId": "photo-visible", "absenceEffect": "additional-evidence-required"}
