{
  "schemaVersion": "1.0.0",
  "id": "photo.fire.special.water.flood-river-overflow",
  "version": "1.0.0",
  "status": "active",
  "titleFa": "الزامات عکس سیل و طغیان رودخانه",
  "claimPackRef": "claim.fire.special.water.flood-river-overflow",
  "coverageRef": "coverage.fire.special.water.flood-river-overflow",
  "sourceRequirementRef": "source.requirements.special-fire-coverage-engine",
  "decisionPolicy": {"automatedFinalDecision": false, "missingPhotoStatus": "additional-evidence-required", "missingPhotoNeverAutoRejects": true},
  "captureProfile": {
    "archive": {"maxEdgePx": 2400, "jpegQuality": 0.86},
    "report": {"maxEdgePx": 1400, "jpegQuality": 0.72},
    "thumbnail": {"maxEdgePx": 320, "jpegQuality": 0.65},
    "preserveOriginalWhenSupported": true,
    "requiredMetadata": ["capturedAt", "source", "sequenceNumber"],
    "optionalMetadata": ["latitude", "longitude", "accuracyMeters", "captionFa"]
  },
  "requirements": [
    {"id": "photo.flood.site-exterior", "titleFa": "نمای بیرونی محل خطر و پیرامون", "requiredMode": "always", "minCount": 2, "maxCount": 6, "evidenceClassificationId": "photo-visible", "mustShowFa": ["ساختمان یا محل خطر", "تراز زمین نسبت به معبر و اطراف"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.flood.water-source-waterway", "titleFa": "منشأ آب یا آبراهه نزدیک", "requiredMode": "required_or_unavailability_reason", "minCount": 1, "maxCount": 6, "evidenceClassificationId": "photo-visible", "mustShowFa": ["رودخانه، مسیل، کانال، روان‌آب یا منشأ ادعایی", "ارتباط مکانی تقریبی با محل خطر"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.flood.entry-route", "titleFa": "مسیر ورود آب", "requiredMode": "always", "minCount": 2, "maxCount": 8, "evidenceClassificationId": "photo-visible", "mustShowFa": ["نقطه ورود", "مسیر حرکت آب در محل"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.flood.waterline", "titleFa": "خط تراز یا بیشینه ارتفاع آب", "requiredMode": "always", "minCount": 2, "maxCount": 6, "evidenceClassificationId": "photo-visible", "mustShowFa": ["اثر خط آب روی سطح ثابت", "خط‌کش یا مرجع اندازه‌گیری"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.flood.depth-reference", "titleFa": "اندازه‌گیری عمق آب", "requiredMode": "required_or_unavailability_reason", "minCount": 1, "maxCount": 4, "evidenceClassificationId": "photo-visible", "mustShowFa": ["مرجع اندازه‌گیری قابل خواندن", "محل اندازه‌گیری"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.flood.affected-area-overview", "titleFa": "نمای کلی بیشترین گستره خسارت", "requiredMode": "always", "minCount": 3, "maxCount": 12, "evidenceClassificationId": "photo-visible", "mustShowFa": ["فضاهای درگیر", "کف، دیوار و اموال آسیب‌دیده"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.flood.below-ground-area", "titleFa": "زیرزمین یا محل زیر تراز زمین", "requiredMode": "required_or_not_applicable_reason", "minCount": 2, "maxCount": 8, "evidenceClassificationId": "photo-visible", "requiredWhen": {"fact": "location.belowGround", "operator": "truthy"}, "mustShowFa": ["راه ورود", "تراز کف نسبت به بیرون"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.flood.mud-contamination", "titleFa": "گل‌ولای، نخاله یا آلودگی", "requiredMode": "required_or_not_applicable_reason", "minCount": 2, "maxCount": 10, "evidenceClassificationId": "photo-visible", "requiredWhen": {"not": {"fact": "flood.mudOrContamination", "operator": "contains", "value": "none"}}, "mustShowFa": ["نوع آلودگی قابل مشاهده", "اموال یا سطح درگیر"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.flood.drainage-condition", "titleFa": "زهکش، آبرو و مسیر تخلیه", "requiredMode": "always", "minCount": 1, "maxCount": 6, "evidenceClassificationId": "photo-visible", "mustShowFa": ["دهانه‌ها و مسیر تخلیه", "گرفتگی یا آسیب قابل مشاهده"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.flood.damaged-property-details", "titleFa": "جزئیات اموال آسیب‌دیده", "requiredMode": "always", "minCount": 2, "maxCount": 30, "evidenceClassificationId": "photo-visible", "repeatPerDamageGroup": true, "mustShowFa": ["نوع مال", "شدت آسیب", "پلاک یا شناسه در صورت وجود"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.flood.cleanup-salvage", "titleFa": "پاک‌سازی، جداسازی و بازیافت", "requiredMode": "required_or_unavailability_reason", "minCount": 1, "maxCount": 12, "evidenceClassificationId": "photo-visible", "mustShowFa": ["اموال آلوده جداشده", "اقلام بازیافتی و عملیات پاک‌سازی"], "absenceEffect": "additional-evidence-required"}
  ],
  "reportBindings": [
    {"reportSectionId": "report.photos.source-location", "requirementIds": ["photo.flood.site-exterior", "photo.flood.water-source-waterway", "photo.flood.entry-route", "photo.flood.drainage-condition"]},
    {"reportSectionId": "report.photos.measurements", "requirementIds": ["photo.flood.waterline", "photo.flood.depth-reference", "photo.flood.below-ground-area"]},
    {"reportSectionId": "report.photos.damage", "requirementIds": ["photo.flood.affected-area-overview", "photo.flood.mud-contamination", "photo.flood.damaged-property-details", "photo.flood.cleanup-salvage"]}
  ]
}
