{
  "schemaVersion": "1.0.0",
  "id": "photo.fire.special.glass.breakage",
  "version": "1.0.0",
  "status": "active",
  "titleFa": "الزامات عکس شکست شیشه",
  "claimPackRef": "claim.fire.special.glass.breakage",
  "coverageRef": "coverage.fire.special.glass.breakage",
  "sourceRequirementRef": "source.requirements.special-fire-coverage-engine",
  "decisionPolicy": {"automatedFinalDecision": false, "missingPhotoStatus": "additional-evidence-required", "missingPhotoNeverAutoRejects": true},
  "captureProfile": {
    "archive": {"maxEdgePx": 2400, "jpegQuality": 0.86},
    "report": {"maxEdgePx": 1400, "jpegQuality": 0.72},
    "thumbnail": {"maxEdgePx": 320, "jpegQuality": 0.65},
    "preserveOriginalWhenSupported": true,
    "requiredMetadata": ["capturedAt", "source", "sequenceNumber"],
    "optionalMetadata": ["latitude", "longitude", "accuracyMeters", "captionFa"]
  },
  "requirements": [
    {"id": "photo.glass.full-elevation", "titleFa": "نمای کامل دهانه", "requiredMode": "always", "minCount": 1, "maxCount": 4, "evidenceClassificationId": "photo-visible", "mustShowFa": ["کل دهانه بیمه‌شده", "محل شیشه نسبت به ساختمان یا ویترین"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.glass.broken-glass", "titleFa": "شیشه شکسته", "requiredMode": "always", "minCount": 2, "maxCount": 8, "evidenceClassificationId": "photo-visible", "mustShowFa": ["الگوی شکست", "لبه‌ها و قسمت باقی‌مانده"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.glass.impact-point", "titleFa": "نقطه احتمالی ضربه", "requiredMode": "required_or_unavailability_reason", "minCount": 1, "maxCount": 5, "evidenceClassificationId": "photo-visible", "mustShowFa": ["مرکز یا ناحیه احتمالی ضربه", "نمای نزدیک الگوی ترک"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.glass.remaining-fragments", "titleFa": "قطعات باقی‌مانده", "requiredMode": "always", "minCount": 1, "maxCount": 6, "evidenceClassificationId": "photo-visible", "mustShowFa": ["قطعات داخل قاب", "قطعات جمع‌آوری‌شده در صورت وجود"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.glass.frame", "titleFa": "قاب و یراق", "requiredMode": "always", "minCount": 2, "maxCount": 8, "evidenceClassificationId": "photo-visible", "mustShowFa": ["هر چهار ضلع قاب", "آسیب قاب، اتصال یا یراق"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.glass.surrounding-area", "titleFa": "محیط اطراف", "requiredMode": "always", "minCount": 2, "maxCount": 6, "evidenceClassificationId": "photo-visible", "mustShowFa": ["کف و فضای دو طرف شیشه", "آثار احتمالی ضربه یا آسیب جانبی"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.glass.measurement-reference", "titleFa": "مرجع اندازه‌گیری", "requiredMode": "always", "minCount": 2, "maxCount": 6, "evidenceClassificationId": "photo-visible", "mustShowFa": ["طول و عرض با متر قابل خواندن", "ضخامت با ابزار یا مدرک قابل اتکا در صورت امکان"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.glass.insured-opening-id", "titleFa": "شناسایی دهانه بیمه‌شده", "requiredMode": "always", "minCount": 1, "maxCount": 4, "evidenceClassificationId": "photo-visible", "mustShowFa": ["شماره، نشانه یا زمینه‌ای که دهانه را یکتا کند", "ارتباط دهانه با محل خطر"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.glass.associated-equipment", "titleFa": "تجهیزات نمایشی یا سرمایشی مرتبط", "requiredMode": "required_or_not_applicable_reason", "minCount": 2, "maxCount": 8, "evidenceClassificationId": "photo-visible", "requiredWhen": {"fact": "equipment.associatedDisplayRefrigeration", "operator": "exists"}, "mustShowFa": ["تجهیز کامل", "ارتباط آن با شیشه و آسیب ادعایی"], "absenceEffect": "additional-evidence-required"},
    {"id": "photo.glass.salvage", "titleFa": "بازیافتی و قطعات تعویض‌شده", "requiredMode": "required_or_unavailability_reason", "minCount": 1, "maxCount": 6, "evidenceClassificationId": "photo-visible", "mustShowFa": ["قطعات قابل بازیافت", "وضعیت نگهداری یا دفع"], "absenceEffect": "additional-evidence-required"}
  ],
  "reportBindings": [
    {"reportSectionId": "report.photos.identification", "requirementIds": ["photo.glass.full-elevation", "photo.glass.insured-opening-id", "photo.glass.measurement-reference"]},
    {"reportSectionId": "report.photos.breakage", "requirementIds": ["photo.glass.broken-glass", "photo.glass.impact-point", "photo.glass.remaining-fragments", "photo.glass.frame", "photo.glass.surrounding-area"]},
    {"reportSectionId": "report.photos.related-items", "requirementIds": ["photo.glass.associated-equipment", "photo.glass.salvage"]}
  ]
}
