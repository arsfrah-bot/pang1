    {"id": "photo.sewer.contamination", "titleFa": "گل‌ولای و آلودگی", "requiredMode": "always", "minCount": 2, "maxCount": 10, "evidenceClassificationId": "photo-visible", "absenceEffect": "additional-evidence-required"},
