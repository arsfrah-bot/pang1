{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazdidyar.local/schemas/domain-catalog-v1.json",
  "title": "Bazdidyar domain catalog container",
  "type": "object",
  "required": ["catalogId", "catalogVersion", "status", "verificationStatus"],
  "properties": {
    "catalogId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "catalogVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"type": "string"},
    "verificationStatus": {"type": "string"},
    "mandatoryVerificationNoticeFa": {"type": "string"},
    "coveragePacks": {"type": "array", "items": {"$ref": "catalog-item.schema.json"}},
    "duties": {"type": "array", "items": {"$ref": "catalog-item.schema.json"}}
  },
  "additionalProperties": true
}
