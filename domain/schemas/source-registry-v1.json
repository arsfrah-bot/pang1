{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazdidyar.local/schemas/source-registry-v1.json",
  "title": "Bazdidyar source registry",
  "type": "object",
  "required": ["catalogId", "catalogVersion", "status", "verificationStatus", "sources"],
  "properties": {
    "catalogId": {"type": "string"},
    "catalogVersion": {"type": "string"},
    "status": {"type": "string"},
    "verificationStatus": {"type": "string"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "titleFa", "descriptionFa", "sourceType", "version", "verificationStatus", "approvingAuthority", "applicability", "reportBindings", "audit"]
      }
    }
  },
  "additionalProperties": true
}
